{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wolter.uz/amt/schemas/upgrade-proposal.schema.json",
  "title": "AMT upgrade proposal",
  "description": "Created by eng-planner in WF-E01/E03 (EVOLUTION_CONTRACT §3). Immutable per revision; an edit is a new revision and invalidates the approval of the previous one.",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_id", "proposal_revision", "created_at", "problem_fingerprint", "signal_refs", "evidence_refs", "baseline_release_id", "change_class", "impact_scope", "allowed_paths", "expected_outcome", "acceptance_basis", "risk", "limits", "tests", "migration", "observation", "recovery", "decision_owner"],
  "properties": {
    "proposal_id": {"type": "string", "pattern": "^UP-[0-9]{8}-[0-9]{3}$"},
    "proposal_revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "problem_fingerprint": {"type": "string", "minLength": 8},
    "signal_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "baseline_release_id": {"type": "string"},
    "change_class": {"enum": ["A_content", "B_code", "C_workflow_harness", "D_schema_migration", "E_protected_surface"]},
    "impact_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "protected_paths_touched": {"type": "array", "items": {"type": "string"}},
    "expected_outcome": {"type": "string", "minLength": 10},
    "acceptance_basis": {"enum": ["business", "technical_no_harm", "both"]},
    "risk": {"type": "object", "additionalProperties": false, "required": ["level", "notes"], "properties": {"level": {"enum": ["low", "medium", "high"]}, "notes": {"type": "string"}}},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_engineering_minor", "currency", "approved_time_limit", "max_attempts"],
      "properties": {
        "max_engineering_minor": {"type": "integer", "minimum": 0},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "approved_time_limit": {"type": "string", "pattern": "^P"},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "tests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "migration": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"enum": ["none", "expand_contract", "forward_repair", "restore_required", "workflow_state_migration"]}, "plan_ref": {"type": ["string", "null"]}}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["scope", "window", "guardrails", "stop_rule"], "properties": {"scope": {"enum": ["isolated", "read_only", "single_pipeline", "full"]}, "window": {"type": "string"}, "guardrails": {"type": "array", "items": {"type": "string"}}, "stop_rule": {"type": "string"}}},
    "recovery": {"type": "object", "additionalProperties": false, "required": ["kind", "ref"], "properties": {"kind": {"enum": ["previous_release", "forward_repair", "restore", "compensation_commands"]}, "ref": {"type": "string"}}},
    "decision_owner": {"const": "owner"},
    "duplicates": {"type": "array", "items": {"type": "string"}}
  }
}
