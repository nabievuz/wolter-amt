{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://wolter.uz/amt/schemas/tools/media.generate_image.schema.json",
 "title": "media.generate_image arguments",
 "description": "Gateway guard 4 argument schema; contract: GUARDRAIL_GATEWAY.md §9.1. model, price upper bound and reservation are server-side (llm-proxy, media_generation share)",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "prompt": {
   "$ref": "_common.schema.json#/$defs/free_text"
  },
  "purpose": {
   "enum": [
    "creative",
    "landing_sketch"
   ]
  },
  "width": {
   "type": "integer",
   "minimum": 1
  },
  "height": {
   "type": "integer",
   "minimum": 1
  },
  "count": {
   "type": "integer",
   "minimum": 1
  }
 },
 "required": [
  "prompt",
  "purpose",
  "width",
  "height"
 ]
}
