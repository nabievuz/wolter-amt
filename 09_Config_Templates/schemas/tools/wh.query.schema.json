{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://wolter.uz/amt/schemas/tools/wh.query.schema.json",
 "title": "wh.query arguments",
 "description": "Gateway guard 4 argument schema; contract: GUARDRAIL_GATEWAY.md §9.1. structured read: the gateway builds one parameterised read-only SELECT on amt_ro with its timeout and row cap; raw SQL is never accepted",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "view": {
   "type": "string",
   "maxLength": 64,
   "pattern": "^v_[a-z0-9_]{1,62}$",
   "description": "an amt_ro view"
  },
  "columns": {
   "type": "array",
   "items": {
    "type": "string",
    "maxLength": 63,
    "pattern": "^[a-z][a-z0-9_]{0,62}$"
   },
   "maxItems": 30,
   "minItems": 1
  },
  "filters": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "column": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9_]{0,62}$"
     },
     "op": {
      "enum": [
       "eq",
       "ne",
       "lt",
       "le",
       "gt",
       "ge",
       "in",
       "between"
      ]
     },
     "value": {
      "oneOf": [
       {
        "type": "string",
        "maxLength": 200,
        "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
       },
       {
        "type": "number"
       },
       {
        "type": "boolean"
       },
       {
        "type": "array",
        "minItems": 1,
        "maxItems": 50,
        "items": {
         "oneOf": [
          {
           "type": "string",
           "maxLength": 200,
           "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
          },
          {
           "type": "number"
          },
          {
           "type": "boolean"
          }
         ]
        }
       }
      ],
      "description": "scalar, or a list for in/between; every element bounded"
     }
    },
    "required": [
     "column",
     "op",
     "value"
    ]
   },
   "maxItems": 10
  },
  "order_by": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "column": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9_]{0,62}$"
     },
     "direction": {
      "enum": [
       "asc",
       "desc"
      ]
     }
    },
    "required": [
     "column",
     "direction"
    ]
   },
   "maxItems": 3
  },
  "limit": {
   "type": "integer",
   "minimum": 1,
   "maximum": 5000,
   "description": "row limit; DATA_MODEL §10.1 caps a query at 5000 rows"
  }
 },
 "required": [
  "view",
  "columns",
  "limit"
 ]
}
