{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wolter.uz/amt/schemas/tools/workflow.start.schema.json",
  "title": "workflow.start arguments",
  "description": "Gateway guard 4 argument schema; contract: WORKFLOW_RUNTIME.md §2. One closed branch per workflow that an agent may start (authorization.may_start; GUARDRAIL_GATEWAY.md §9.1): exactly the definition's input fields, bounded.",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "dedup_key",
        "correlation_key",
        "input"
      ],
      "properties": {
        "workflow_id": {
          "const": "WF-B02"
        },
        "dedup_key": {
          "$ref": "_common.schema.json#/$defs/ref"
        },
        "correlation_key": {
          "$ref": "_common.schema.json#/$defs/ref"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "brief_id",
            "pipeline",
            "hypothesis",
            "offer_revision_refs",
            "formats",
            "languages"
          ],
          "properties": {
            "brief_id": {
              "$ref": "_common.schema.json#/$defs/ref"
            },
            "pipeline": {
              "$ref": "_common.schema.json#/$defs/pipeline"
            },
            "hypothesis": {
              "$ref": "_common.schema.json#/$defs/input_text"
            },
            "offer_revision_refs": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "_common.schema.json#/$defs/ref"
              }
            },
            "formats": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "$ref": "_common.schema.json#/$defs/slug"
              }
            },
            "languages": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "$ref": "_common.schema.json#/$defs/slug"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "dedup_key",
        "correlation_key",
        "input"
      ],
      "properties": {
        "workflow_id": {
          "const": "WF-B04"
        },
        "dedup_key": {
          "$ref": "_common.schema.json#/$defs/ref"
        },
        "correlation_key": {
          "$ref": "_common.schema.json#/$defs/ref"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "change_request_id",
            "pipeline",
            "kind",
            "rationale",
            "evidence_refs"
          ],
          "properties": {
            "change_request_id": {
              "$ref": "_common.schema.json#/$defs/ref"
            },
            "pipeline": {
              "$ref": "_common.schema.json#/$defs/pipeline"
            },
            "kind": {
              "enum": [
                "offer",
                "landing_content",
                "tracking"
              ]
            },
            "rationale": {
              "$ref": "_common.schema.json#/$defs/input_text"
            },
            "evidence_refs": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "_common.schema.json#/$defs/ref"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "dedup_key",
        "correlation_key",
        "input"
      ],
      "properties": {
        "workflow_id": {
          "const": "WF-B05"
        },
        "dedup_key": {
          "$ref": "_common.schema.json#/$defs/ref"
        },
        "correlation_key": {
          "$ref": "_common.schema.json#/$defs/ref"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "experiment_id",
            "pipeline",
            "hypothesis",
            "primary_metric",
            "guardrail_metrics",
            "min_sample",
            "maturity",
            "max_exposure",
            "design"
          ],
          "properties": {
            "experiment_id": {
              "$ref": "_common.schema.json#/$defs/ref"
            },
            "pipeline": {
              "$ref": "_common.schema.json#/$defs/pipeline"
            },
            "hypothesis": {
              "$ref": "_common.schema.json#/$defs/input_text"
            },
            "primary_metric": {
              "$ref": "_common.schema.json#/$defs/metric"
            },
            "guardrail_metrics": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "$ref": "_common.schema.json#/$defs/slug"
              }
            },
            "min_sample": {
              "type": "integer",
              "minimum": 1
            },
            "maturity": {
              "$ref": "_common.schema.json#/$defs/short_text"
            },
            "max_exposure": {
              "$ref": "_common.schema.json#/$defs/short_text"
            },
            "design": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "decision",
                "mde_pct",
                "alpha",
                "power",
                "alpha_sided",
                "min_exposure",
                "max_duration",
                "test",
                "verdict_map",
                "looks"
              ],
              "properties": {
                "decision": {
                  "enum": [
                    "superiority",
                    "non_inferiority",
                    "exploratory"
                  ]
                },
                "mde_pct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000
                },
                "margin_pct": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 100
                },
                "alpha": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 0.5
                },
                "power": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1
                },
                "alpha_sided": {
                  "enum": [
                    "one_sided",
                    "two_sided"
                  ]
                },
                "min_exposure": {
                  "$ref": "_common.schema.json#/$defs/short_text"
                },
                "max_duration": {
                  "$ref": "_common.schema.json#/$defs/short_text"
                },
                "test": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "statistic",
                    "variance_model",
                    "baseline_uncertainty"
                  ],
                  "properties": {
                    "statistic": {
                      "$ref": "_common.schema.json#/$defs/short_text"
                    },
                    "variance_model": {
                      "$ref": "_common.schema.json#/$defs/short_text"
                    },
                    "baseline_uncertainty": {
                      "$ref": "_common.schema.json#/$defs/short_text"
                    }
                  }
                },
                "verdict_map": {
                  "$ref": "_common.schema.json#/$defs/short_text"
                },
                "looks": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "dedup_key",
        "correlation_key",
        "input"
      ],
      "properties": {
        "workflow_id": {
          "const": "WF-E05"
        },
        "dedup_key": {
          "$ref": "_common.schema.json#/$defs/ref"
        },
        "correlation_key": {
          "$ref": "_common.schema.json#/$defs/ref"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proposal_slug",
            "proposal_revision",
            "role",
            "owned_responsibility",
            "parent_role",
            "tools",
            "model",
            "share_minor",
            "currency",
            "evaluation",
            "evidence"
          ],
          "properties": {
            "proposal_slug": {
              "$ref": "_common.schema.json#/$defs/slug"
            },
            "proposal_revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "role": {
              "$ref": "_common.schema.json#/$defs/short_text"
            },
            "owned_responsibility": {
              "$ref": "_common.schema.json#/$defs/input_text"
            },
            "parent_role": {
              "enum": [
                "media-buyer",
                "funnel-analyst",
                "cro",
                "creative-studio"
              ]
            },
            "tools": {
              "type": "array",
              "minItems": 1,
              "maxItems": 25,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z_]+\\.[a-z0-9_.*]+$"
              }
            },
            "model": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9._/:-]+$"
            },
            "share_minor": {
              "type": "integer",
              "minimum": 1,
              "maximum": 15000
            },
            "evaluation": {
              "$ref": "_common.schema.json#/$defs/input_text"
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "$ref": "_common.schema.json#/$defs/ref"
              }
            },
            "currency": {
              "$ref": "_common.schema.json#/$defs/currency"
            }
          }
        }
      }
    }
  ]
}
