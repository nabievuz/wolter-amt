# Project OS variable NAMES and custody only — never values.
# One rendered env file per service (runtime-isolation.yaml#services.credential_file); no shared full env.
# Secrets: sops+age outside git/logs/traces. Annotation per variable: [non-secret] [secret] [hash] [must-be-empty-here].

# --- common, every service (non-secret) ---
AMT_ENV=                                  # [non-secret] prod|staging|sandbox|restore_test|restore_drill (environments.yaml)
AMT_CONFIG_DIR=/opt/wolter-amt/config     # [non-secret]
AMT_KNOWLEDGE_DIR=/opt/wolter-amt/knowledge
AMT_CONFIG_SHA=
AMT_CODE_SHA=
AMT_MANIFEST_DIGEST=
AMT_SCHEMA_VERSION=1
TZ=Asia/Tashkent

# --- amt-release (root publisher) and amt-backup: deploy and recovery only; builds run as amt-build ---
AMT_REPO_READONLY_DEPLOY_KEY=             # [secret] read-only
AMT_RELEASE_TAG_PATTERN=release-*         # [non-secret]
AMT_RELEASE_SIGNERS_FILE=/etc/amt/release-signers
RELEASE_DATABASE_URL=                     # [secret] role amt_release
MIGRATOR_DATABASE_URL=                    # [secret] login role amt_migrate (SET ROLE amt_migrator only, used during prepare)
AMT_SNAPSHOT_DIR=/var/backups/amt          # local snapshot target on the same RAID1 (Q55); unencrypted (Q54)

# --- cloudflared: the only ingress path (Q57); Tailscale node state stays in /var/lib/tailscale (Q58) ---
TUNNEL_TOKEN=                             # [secret] cloudflared tunnel token (Q57, HG-F0-02); rendered into /run/amt/secrets/cloudflared.env, never passed with --token on the command line

# --- amt-control: local containment ---
CONTROL_DATABASE_URL=                     # [secret] role amt_control
AMT_CONTROL_LATCH_PATH=/var/lib/amt-control/kill-state
AMT_CONTROL_SOCKET=/run/amt-control/control.sock
CONTROL_ALLOWED_PEER_UIDS=                # [non-secret] amt-ops, amt-sync, amt-watchdog, amt-workflow, root (amt-kill, amt-release) - runtime-isolation.yaml#control_socket_peers
INDEPENDENT_MONITOR_ENDPOINT=             # [non-secret]
INDEPENDENT_MONITOR_SEND_TOKEN=           # [secret] heartbeats and the journal mirror for kill/mode/role events
INDEPENDENT_MONITOR_ACK_KEY=              # [secret] HMAC key that verifies monitor ACKs (store-before-ACK echo of observed_at and nonce); a forged ACK cannot extend the CAPI dispatch lease
INDEPENDENT_MONITOR_ACK_KEY_NEXT=         # [secret] only during an ACK-key rotation: amt-control accepts ACKs under the current and the next key (dual-key window), so the rotation never pauses CAPI
INTERNAL_HMAC_KEYS_FILE=                  # [secret path]

# --- paperclip: orchestrator only; no marketing or provider credentials ---
DATABASE_URL=                             # [secret] own paperclip database (no embedded PostgreSQL)
PAPERCLIP_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
TRUST_PROXY=
PAPERCLIP_PUBLIC_URL=https://mar.wolter.uz
PAPERCLIP_API_URL=http://127.0.0.1:3100/api
MANAGED_RUNNER_SOCKET=
MANAGED_RUNNER_CALLER_TOKEN=              # [secret]

# --- each isolated agent worker: separate env, run and UID ---
GW_TOKEN=                                 # [secret] per agent run
LLMPROXY_AGENT_TOKEN=                     # [secret] per agent
AMT_AGENT_ID=
AMT_RUN_ID=
AMT_RUN_AUDIENCE=
ANTHROPIC_BASE_URL=http://127.0.0.1:3500/anthropic
ANTHROPIC_AUTH_TOKEN=                     # [secret] = proxy token, never a provider key
ANTHROPIC_API_KEY=                        # [must-be-empty-here]
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
CLAUDE_CODE_SUBAGENT_MODEL=
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:3500/otel
OTEL_RESOURCE_ATTRIBUTES=

# --- hermes (CMO) ---
HERMES_LLM_BASE_URL=http://127.0.0.1:3500/openai
HERMES_LLM_PROXY_TOKEN=                   # [secret] provider cmo-chat: Telegram chat and voice-note STT (sub_shares.cmo chat part)
HERMES_LLM_PROXY_WORKFLOW_TOKEN=          # [secret] provider cmo-workflow: Hermes API-server runs started by amt-workflow (sub_shares.cmo workflow part, P-101)
TG_HERMES_BOT_TOKEN=                      # [secret] CMO bot; never an approval channel
HERMES_API_SERVER_KEY=                    # [secret]

# --- llm-proxy: the only holder of the OpenRouter key ---
LLMPROXY_BIND=127.0.0.1:3500
OPENROUTER_API_KEY=                       # [secret]
LLMPROXY_DATABASE_URL=                    # [secret] role amt_proxy
LLMPROXY_AGENT_TOKEN_HASHES_FILE=         # [hash]
LLMPROXY_GATEWAY_TOKEN_HASH=              # [hash]
LLMPROXY_PROVIDER_POLICY=                 # [non-secret] data_collection deny, Anthropic 1P first
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=                      # [secret]
LANGFUSE_SECRET_KEY=                      # [secret]

# --- gateway: proposals, sanitized reads, PR tokens; no Meta write key ---
GATEWAY_BIND=127.0.0.1:3300
GATEWAY_DATABASE_URL=                     # [secret] role amt_gateway
GATEWAY_READER_DATABASE_URL=              # [secret] read-only role
GATEWAY_AGENT_TOKEN_HASHES_FILE=          # [hash]
LLMPROXY_URL=http://127.0.0.1:3500
LLMPROXY_GATEWAY_TOKEN=                   # [secret] media generation calls and the Jev pre-screen Decisions endpoint only (Q61)
META_AD_ACCOUNT_ID=
META_BUSINESS_ID=
META_API_VERSION=
META_ADS_MCP_VERSION=
GDRIVE_SERVICE_ACCOUNT_JSON_PATH=         # [secret path] read
GDRIVE_RAW_FOLDER_ID=
GITHUB_TOKEN_LANDING=                     # [secret] PR scope only
GITHUB_TOKEN_AMT_OFFERS=                  # [secret] PR scope only
UMAMI_API_URL=
UMAMI_API_TOKEN=                          # [secret] read
CLARITY_API_TOKEN=                        # [secret] read

# --- executor: narrow per-command Meta writes + pause-only emergency path ---
EXECUTOR_DATABASE_URL=                    # [secret] role amt_executor
META_WRITE_TOKEN=                         # [secret] system user amt-write
EXECUTOR_DISPATCH_SOCKET=
EXECUTOR_META_AD_ACCOUNT_ID=
EXECUTOR_META_API_VERSION=

# --- meta-ads-mcp (amt-meta-read): read token only; does not inherit any other env ---
META_READ_TOKEN=                          # [secret] system user amt-read

# --- amocrm-mcp (amt-amo): the only amoCRM credential holder; quota-enforced ---
AMO_SUBDOMAIN=
AMO_TOKEN=                                # [secret] [user-rights] holds the issuing amoCRM user's rights (VR-16); issued at HG-F2-04 as the least-privileged existing user that covers the AMT pipelines and fields
AMO_DATABASE_URL=                         # [secret] role amt_amo
AMO_QUOTA_ALLOCATION_ID=
AMO_CAPI_LOOKUP_SOCKET=                   # [non-secret] peer UID amt-capi only
AMO_FIELD_AMT_FT_UTM=
AMO_FIELD_AMT_FBC=
AMO_FIELD_AMT_FBP=
AMO_FIELD_AMT_EVENT_ID=
AMO_FIELD_AMT_SUBMISSION_ID=
AMO_FIELD_AMT_CONSENT_RECEIPT_REF=
AMO_FIELD_AMT_CLIENT_IP=
AMO_FIELD_AMT_CLIENT_UA=
AMO_FIELD_AMT_VARIANT_ID=
AMO_FIELD_AMT_CONSENT=
AMO_FIELD_AMT_CONSENT_VERSION=
AMO_FIELD_AMT_CREATIVE_ID=
AMO_FIELD_AMT_QUALITY_FLAG=
AMO_FIELD_AMT_LEAD_SCORE=

# --- quota-coordinator ---
QUOTA_DATABASE_URL=                       # [secret] role amt_quota

# --- sync-worker: reads through local connectors; own Umami read token ---
SYNC_DATABASE_URL=                        # [secret] role amt_sync
SYNC_UMAMI_API_TOKEN=                     # [secret] read
SYNC_AMO_SOCKET=
SYNC_META_READ_SOCKET=
SYNC_LANDING_DELIVERY_URL=                # [non-secret] https://go.wolter.uz/internal/delivery - PII-free delivery states, pull with a cursor
SYNC_LANDING_DELIVERY_TOKEN=              # [secret] read-only delivery-state token; the landing keeps only its hash

# --- capi-bridge: PII transient in memory, consent required ---
CAPI_BIND=127.0.0.1:3400
CAPI_DATABASE_URL=                        # [secret] role amt_capi
AMO_WEBHOOK_SECRET=                       # [secret]
META_DATASET_ID=
META_CAPI_TOKEN=                          # [secret]
CAPI_TEST_EVENT_CODE=                     # [non-secret] staging only (environments.yaml)

# --- landing (separate production Dokploy host) ---
LANDING_SUBMISSION_STORE_PATH=
LANDING_SUBMISSION_ENCRYPTION_KEY=        # [secret]
LANDING_CRM_CREDENTIAL=                   # [secret] [user-rights] holds the issuing amoCRM user's rights (VR-16); the vendor cannot narrow it to lead creation - the landing code allowlist is the only narrowing
LANDING_QUOTA_ALLOCATION_ID=
LANDING_CUSTODY_BACKUP_TARGET=
LANDING_INDEPENDENT_HEALTH_TOKEN=         # [secret]
LANDING_DELIVERY_READ_TOKEN_HASH=         # [hash] verifies the AMT sync-worker delivery reads (GET /internal/delivery)

# --- ops-bot (amt-ops) ---
OPSBOT_BIND=127.0.0.1:3201
OPSBOT_DATABASE_URL=                      # [secret] role amt_ops
TG_OPS_BOT_TOKEN=                         # [secret]
TG_LOCAL_API_URL=http://127.0.0.1:8081
TG_LOCAL_WEBHOOK_URL=http://127.0.0.1:3201/tg
TG_GROUP_CHAT_ID=
TG_STAGING_BOT_TOKEN=                      # [secret] staging environment only (environments.yaml)
TG_STAGING_CHAT_ID=                       # [non-secret] staging environment only
GDRIVE_UPLOAD_SERVICE_ACCOUNT_JSON_PATH=  # [secret path] upload to AMT/raw quarantine only
CONTENT_QUARANTINE_PATH=

# --- telegram-bot-api (amt-telegram) ---
TG_API_ID=                                # [secret]
TG_API_HASH=                              # [secret]

# --- tg-auth (amt-auth) ---
TGAUTH_BIND=127.0.0.1:3200
TGAUTH_DATABASE_URL=                      # [secret] role amt_auth
TG_AUTH_SESSION_KEY=                      # [secret]
TG_AUTH_COOKIE_DOMAIN=
TG_AUTH_HOSTS=

# --- cost-watchdog (amt-watchdog) ---
WATCHDOG_DATABASE_URL=                    # [secret] role amt_watchdog
OPENROUTER_USAGE_READ_CREDENTIAL=         # [secret] usage read only
PAPERCLIP_BOARD_TOKEN=                    # [secret] agent pause only; scope verified in F1

# --- amt-workflow ---
WORKFLOW_DATABASE_URL=                    # [secret] role amt_workflow
WORKFLOW_PAPERCLIP_PROJECTION_TOKEN=      # [secret] issue projection only

# --- amt-verify / amt-sandbox / amt-eng-proxy (evolution layer) ---
VERIFY_DATABASE_URL=                      # [secret] role amt_verify
VERIFY_HOLDOUT_KEY_PATH=/var/lib/amt-verify/holdout.key
SANDBOX_PACKAGE_PROXY_URL=
ENG_GITHUB_TOKEN=                         # [secret] amt-sandbox only; push cand/* branches only
ENG_PROXY_DATABASE_URL=                   # [secret] role amt_eng_proxy
ENG_PROVIDER_API_KEY=                     # [secret] separate engineering key (OD-02); never the runtime OpenRouter key

# --- langfuse (own container stack and PostgreSQL) ---
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
TELEMETRY_ENABLED=false                   # [non-secret] Langfuse product telemetry off - no egress to the vendor (DOCKER-USER also drops new outbound connections)
LANGFUSE_MINIO_ROOT_PASSWORD=
